# Supabase Configuration
# Consigue estos valores en: https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=tu_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# INSTRUCCIONES:
# 1. Ve a tu proyecto en Supabase
# 2. Settings > API
# 3. Copia "Project URL" y pégalo en NEXT_PUBLIC_SUPABASE_URL
# 4. Copia "anon public" key y pégala en NEXT_PUBLIC_SUPABASE_ANON_KEY
