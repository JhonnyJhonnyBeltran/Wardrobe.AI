default_platform(:ios)

platform :ios do
  desc "Compilar y enviar a TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password_klozet",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_path = File.expand_path("~/Library/Keychains/ci_keychain-db")
    kc_path = File.expand_path("~/Library/Keychains/ci_keychain") unless File.exist?(kc_path)

    # Ensure there is room for a new certificate (Apple limit is 2 for individual accounts)
    begin
      certs = Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: "DISTRIBUTION" })
      if certs.count >= 2
        UI.message("Account reached 2 distribution certificates. Revoking oldest certificate...")
        certs.first.delete!
      end
    rescue => ex
      UI.important("Non-fatal certificate cleanup note: #{ex.message}")
    end

    get_certificates(
      api_key: api_key,
      keychain_path: kc_path,
      keychain_password: "ci_password_klozet"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "es.klozet.app"
    )

    build_ver = Time.now.strftime("%Y%m%d%H%M")
    profile_name = lane_context[SharedValues::SIGH_NAME] || "es.klozet.app AppStore"
    profile_uuid = lane_context[SharedValues::SIGH_UUID]

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      team_id: "QH686PH7MM",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "es.klozet.app"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "es.klozet.app" => profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=QH686PH7MM CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER='#{profile_name}' CURRENT_PROJECT_VERSION=#{build_ver}"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
