default_platform(:ios)

platform :ios do
  desc "Compilar y enviar a TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APPSTORE_KEY_ID"],
      issuer_id: ENV["APPSTORE_ISSUER_ID"],
      key_content: ENV["APPSTORE_PRIVATE_KEY"],
      is_key_content_base64: false,
      in_house: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password_klozet",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    get_certificates(
      api_key: api_key,
      create_new: true,
      keychain_name: "ci_keychain",
      keychain_password: "ci_password_klozet"
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "es.klozet.app"
    )

    build_ver = Time.now.strftime("%Y%m%d%H%M")

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App.xcodeproj",
      profile_name: ENV["sigh_es.klozet.app_appstore_profile-name"],
      bundle_identifier: "es.klozet.app"
    )

    build_app(
      project: "App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_ver}",
      keychain_name: "ci_keychain",
      keychain_password: "ci_password_klozet"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
